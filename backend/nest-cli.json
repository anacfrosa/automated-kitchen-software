{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/webbff/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/webbff/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/webbff",
  "projects": {
    "webbff": {
      "type": "application",
      "root": "apps/webbff",
      "entryFile": "main",
      "sourceRoot": "apps/webbff/src",
      "compilerOptions": {
        "tsConfigPath": "apps/webbff/tsconfig.app.json"
      }
    },
    "adminbff": {
      "type": "application",
      "root": "apps/adminbff",
      "entryFile": "main",
      "sourceRoot": "apps/adminbff/src",
      "compilerOptions": {
        "tsConfigPath": "apps/adminbff/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/adminbff"
          }
        ]
      }
    },
    "products": {
      "type": "application",
      "root": "apps/products",
      "entryFile": "main",
      "sourceRoot": "apps/products/src",
      "compilerOptions": {
        "tsConfigPath": "apps/products/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/products"
          }
        ]
      }
    },
    "kitchens": {
      "type": "application",
      "root": "apps/kitchens",
      "entryFile": "main",
      "sourceRoot": "apps/kitchens/src",
      "compilerOptions": {
        "tsConfigPath": "apps/kitchens/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/kitchens"
          }
        ]
      }
    },
    "suppliers": {
      "type": "application",
      "root": "apps/suppliers",
      "entryFile": "main",
      "sourceRoot": "apps/suppliers/src",
      "compilerOptions": {
        "tsConfigPath": "apps/suppliers/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/suppliers"
          }
        ]
      }
    },
    "analytics": {
      "type": "application",
      "root": "apps/analytics",
      "entryFile": "main",
      "sourceRoot": "apps/analytics/src",
      "compilerOptions": {
        "tsConfigPath": "apps/analytics/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/analytics"
          }
        ]
      }
    },
    "notifications": {
      "type": "application",
      "root": "apps/notifications",
      "entryFile": "main",
      "sourceRoot": "apps/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notifications/tsconfig.app.json",
        "assets": [
          {
            "include": "i18n/**/*",
            "watchAssets": true,
            "outDir": "dist/apps/notifications"
          }
        ]
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    },
    "uploader": {
      "type": "library",
      "root": "libs/uploader",
      "entryFile": "index",
      "sourceRoot": "libs/uploader/src",
      "compilerOptions": {
        "tsConfigPath": "libs/uploader/tsconfig.lib.json"
      }
    }
  }
}
